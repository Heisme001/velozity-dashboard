# Backend environment variables
# Copy this to .env and fill in real values

PORT=5000
NODE_ENV=development

# PostgreSQL (use the docker service name 'postgres' when running in Docker Compose)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/velozity_db?schema=public"

# JWT secrets – change these before deploying to production!
JWT_ACCESS_SECRET="super_secret_access_jwt_key_velozity_2026"
JWT_REFRESH_SECRET="super_secret_refresh_jwt_key_velozity_2026"

# URL of the frontend (used for CORS in production)
FRONTEND_URL="http://localhost:5173"
